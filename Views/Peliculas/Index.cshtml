@model IEnumerable<MVCconBD2.Models.Pelicula>

@{
    ViewData["Title"] = "Cartelera";
}

<div class="container mt-4">
    <h1 class="text-center text-primary mb-4">🎬 Cartelera de Películas</h1>

    <div class="d-flex justify-content-end mb-3">
        <a asp-action="Create" class="btn btn-success shadow-sm">
            ➕ Agregar Nueva Película
        </a>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="text-center">Póster</th>
                    <th>@Html.DisplayNameFor(model => model.Titulo)</th>
                    <th>@Html.DisplayNameFor(model => model.Anio)</th>
                    <th>@Html.DisplayNameFor(model => model.Genero)</th>
                    <th>@Html.DisplayNameFor(model => model.Director)</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">
                            <img src="/imagenes/@(item.Id).jpg" class="img-thumbnail shadow-sm" style="width: 80px; height: 115px; object-fit: cover;" alt="Póster de @item.Titulo" />
                            
                        </td>
                        <td class="fw-bold">
                            @Html.DisplayFor(modelItem => item.Titulo)
                        </td>
                        <td>
                            @item.Anio.ToShortDateString()
                        </td>
                        <td>
                            <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.Genero)</span>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Director)
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">✏️ Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">🔍 Detalles</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">🗑️ Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>