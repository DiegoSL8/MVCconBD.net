@model IEnumerable<MVCconBD2.Models.Pelicula>

@{
    ViewData["Title"] = "Cartelera";
}

<div class="container mt-4">
    <h1 class="text-center text-primary mb-4">🎬 Cartelera de Películas</h1>

    <div class="row mb-3 align-items-center">
        <div class="col-md-8">
            <form asp-controller="Peliculas" asp-action="Index" method="get" class="d-flex shadow-sm">
                <input type="text" name="buscarTitulo" value="@ViewBag.BuscarTitulo" class="form-control rounded-start" placeholder="🔍 Buscar película por título..." />
                <button type="submit" class="btn btn-primary">Buscar</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2 rounded">Limpiar</a>
            </form>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-success shadow-sm">
                ➕ Agregar Película
            </a>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded mb-4">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="text-center">Póster</th>
                    <th>@Html.DisplayNameFor(model => model.Titulo)</th>
                    <th>@Html.DisplayNameFor(model => model.Anio)</th>
                    <th>@Html.DisplayNameFor(model => model.Genero)</th>
                    <th>@Html.DisplayNameFor(model => model.Director)</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">
                            <img src="/imagenes/@(item.Id).jpg" class="img-thumbnail shadow-sm" style="width: 80px; height: 115px; object-fit: cover;" alt="Póster" />
                        </td>
                        <td class="fw-bold">@Html.DisplayFor(modelItem => item.Titulo)</td>
                        <td>@item.Anio.ToShortDateString()</td>
                        <td><span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.Genero)</span></td>
                        <td>@Html.DisplayFor(modelItem => item.Director)</td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">✏️ Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">🔍</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">🗑️</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPaginas > 1)
    {
        <nav aria-label="Navegación de páginas">
            <ul class="pagination justify-content-center shadow-sm">
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-numeroPagina="@i" asp-route-buscarTitulo="@ViewBag.BuscarTitulo">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>